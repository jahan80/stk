# Maven
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iml
.vscode/
*.swp

# OS
.DS_Store

# Logs
*.log
logs/

# Env
.env
*.local

# Docs (local only)
*.docx
temp.txt


# ============================================
# Added: 2026-09-27 (SMTP integration)
# ============================================
# Secrets (never commit!)
.env
.env.*
!.env.example

# Backups
*.bak
*.bak.*
.dockerignore.bak


# ============================================
# Frontend (React + Vite)
# ============================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/*.log
all_project_files.txt

# ============================================
# JWT Keys
# ============================================
# NEVER commit private keys.
**/jwt-private.pem
**/*-private.pem
**/*-private-key.pem

# Public keys ARE committed (shared by all services for JWT verification).
!**/jwt-public.pem
!**/*-public.pem

# Outbox backups
.backup-outbox-*

# Listener backups
.backup-listener-*
# Filter backups
.backup-filters-*

# All local backups
.backup-*/
.backup-*
